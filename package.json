{
  "name": "record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "build:widget": "scripts/build-call-widget",
    "build:stream-helper": "scripts/build-stream-helper",
    "build:voice-engine": "make -C native/discord-voice-engine build",
    "install:voice-engine": "make -C native/discord-voice-engine install",
    "check:voice-engine": "make -C native/discord-voice-engine check",
    "test:voice-engine": "make -C native/discord-voice-engine test",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run test && bun run check:voice-engine"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "1.5.6",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@lng2004/node-datachannel": "^0.32.0-20260202",
    "@snazzah/davey": "^0.1.11",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "discord-emoji": "2.5.3",
    "pino": "9.6.0",
    "qrcode": "1.5.4",
    "tsx": "4.19.0"
  },
  "trustedDependencies": [
    "@lng2004/node-datachannel",
    "@whiskeysockets/baileys",
    "esbuild",
    "protobufjs"
  ]
}
