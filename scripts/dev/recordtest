#!/usr/bin/env bash
# recordtest — launch a worktree's record TUI for testing.
#
# Usage:
#   recordtest <worktree>
#
# <worktree> can be:
#   - A bare name:       recordtest fix-sidebar-scroll
#   - A relative path:   recordtest .worktrees/fix-sidebar-scroll
#   - An absolute path:  recordtest /home/.../record/.worktrees/fix-sidebar-scroll
#
# Installs dependencies, seeds an isolated copy of the user's record config if
# needed, then launches the worktree's TUI with XDG_CONFIG_HOME pointed at the
# worktree-local config directory.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./worktree-common.sh
source "$SCRIPT_DIR/worktree-common.sh"

# ── Resolve worktree ────────────────────────────────────────────────

INPUT="${1:-}"
WORKTREE_DIR="$(resolve_worktree_dir "$INPUT")"

[[ -d "$WORKTREE_DIR" ]]     || worktree_die "Not found: $WORKTREE_DIR"
[[ -d "$WORKTREE_DIR/src" ]] || worktree_die "No src/ in $WORKTREE_DIR"
[[ -f "$WORKTREE_DIR/package.json" ]] || worktree_die "No package.json in $WORKTREE_DIR"

WT_NAME="$(basename "$WORKTREE_DIR")"

printf '\n  recordtest — %s\n  %s\n\n' "$WT_NAME" "$WORKTREE_DIR"

# ── Dependencies ────────────────────────────────────────────────────

# Always run bun install — it's idempotent and catches stale/partial node_modules.
(cd "$WORKTREE_DIR" && bun install --silent)

# ── Isolated local config ───────────────────────────────────────────

sync_shared_config "$WORKTREE_DIR"

CONFIG_HOME="$WORKTREE_DIR/config"
CONFIG_DIR="$CONFIG_HOME/record"
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_HOME" "$CONFIG_DIR" 2>/dev/null || true

export XDG_CONFIG_HOME="$CONFIG_HOME"
export RECORD_INSTANCE="$WT_NAME"

printf '  Config: %s\n\n' "$CONFIG_DIR"

# ── TUI ─────────────────────────────────────────────────────────────

(cd "$WORKTREE_DIR" && exec bun run src/main.ts)
